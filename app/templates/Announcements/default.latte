{block title}Oznámení{/block}

{block content}
<div data-test="announcements-page">
    <div class="card page-heading">
        <div class="card-body">
            <h1 class="h3 mb-2">Oznámení</h1>
            {include pageLead, default: 'Aktuální zprávy a informace pro uživatele.'}
        </div>
    </div>

    <section n:if="$announcements !== []" class="card" data-test="announcements-list">
        <div class="card-body">
            {control grid}
        </div>
    </section>
    <div n:if="$announcements === []" class="alert alert-light" data-test="announcements-empty">
        Momentálně nejsou k dispozici žádná oznámení.
    </div>
</div>
{/block}
