{**
 * Contextual page help. The only place the panel is defined, so its look and its
 * controls are identical on every page. The content comes from the `page_help`
 * table and is edited in Admin:Help - never written into a template.
 *
 * @param App\Model\Help\Entity\PageHelp $pageHelp
 *}
<aside class="design-help-sidebar" data-help-card data-test="help-sidebar">
    <button
        type="button"
        class="btn btn-link p-0 pb-2 border-bottom w-100 text-start text-decoration-none d-inline-flex align-items-center gap-2"
        data-help-toggle
        data-test="help-toggle"
        aria-expanded="true"
        title="Skrýt nápovědu"
    >
        <span class="help-sidebar-icon d-inline-flex align-items-center justify-content-center rounded-3 bg-primary bg-opacity-10 p-2"
              data-test="help-title-icon">
            <i class="fi fi-rr-lightbulb-on text-primary" aria-hidden="true"></i>
        </span>
        <span class="fw-semibold text-primary-emphasis" data-help-content>Nápověda</span>
    </button>
    {var $youtubeUrl = $pageHelp->getYoutubeUrl()}
    <div n:if="$youtubeUrl !== null" class="mt-2 mb-2" data-help-youtube>
        <a href="{$youtubeUrl}" target="_blank" rel="nofollow noopener noreferrer"
           class="d-flex align-items-center gap-2 text-decoration-none fw-semibold"
           data-test="help-youtube-link"
           title="{$pageHelp->getYoutubeTitle()}"
           aria-label="Video: {$pageHelp->getYoutubeTitle()}">
            <span class="help-sidebar-icon d-inline-flex align-items-center justify-content-center rounded-3 bg-danger bg-opacity-10 p-2"
                  data-test="help-youtube-icon">
                <i class="fi fi-brands-youtube text-danger" aria-hidden="true"></i>
            </span>
            <span class="text-break align-self-center" data-test="help-youtube-title">{$pageHelp->getYoutubeTitle()}</span>
        </a>
    </div>
    <div n:class="$youtubeUrl !== null ? 'mt-2'" data-help-content data-test="help-content">
        {foreach $pageHelp->getSections() as $section}
            <div n:class="$iterator->last ? 'mb-0' : 'mb-3'">
                <strong>{$section->getHeading()}</strong><br>
                {$section->getText()}
                <ul n:if="$section->hasItems()" class="small mt-2 mb-0">
                    <li n:foreach="$section->getItems() as $item">{$item}</li>
                </ul>
            </div>
        {/foreach}
    </div>
</aside>
