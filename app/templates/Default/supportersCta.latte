<section class="card bg-body-tertiary h-100" data-test="supporters-cta" aria-labelledby="supporters-cta-title">
    <div class="card-body d-flex flex-column">
        {if $headingLevel === 2}
            <h2 id="supporters-cta-title" class="h5 fw-bold mb-3">Podporovatelé</h2>
        {else}
            <h3 id="supporters-cta-title" class="h5 fw-bold mb-3">Podporovatelé</h3>
        {/if}
