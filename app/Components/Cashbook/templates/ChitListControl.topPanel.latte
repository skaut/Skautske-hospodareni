<div class="cashbook-toolbar d-flex flex-wrap align-items-center justify-content-start justify-content-md-end gap-2">
    <a n:href="prefix:open!" class="btn btn-sm btn-light ajax">
        Prefix: {if $prefix !== null}{$prefix}{else}žádný{/if}
    </a>

    <a n:href="generateNumbers! $paymentMethod->toString ()" n:class="btn, btn-sm, btn-warning, ! $hasOnlyNumericChitNumbers ? disabled"
            data-bs-toggle="tooltip" data-placement="top" title="Generovat čísla dokladů lze když stávající obsahují pouze číslice.">
        Dogenerovat čísla dokladů
    </a>

    {var $method = $paymentMethod->toString()}
    {if ! $cashbookType->isUnit()}
        {include '../../templates/FileActionButton.latte',
            label => 'Stáhnout PDF',
            downloadUrl => $presenter->link(':Unit:CashbookExport:printCashbook', [$cashbookId, $method, download => true]),
            openUrl => $presenter->link(':Unit:CashbookExport:printCashbook', [$cashbookId, $method]),
            disabled => count($chits) === 0,
            dataTest => 'cashbook-' . $method . '-pdf',
        }
    {/if}
    {include '../../templates/FileActionButton.latte',
        label => 'Stáhnout Excel',
        downloadUrl => $presenter->link(':Unit:CashbookExport:exportCashbook', [$cashbookId, $method]),
        disabled => count($chits) === 0,
        dataTest => 'cashbook-' . $method . '-excel',
    }
    {include '../../templates/FileActionButton.latte',
        label => 'Stáhnout rozšířený Excel',
        downloadUrl => $presenter->link(':Unit:CashbookExport:exportCashbookWithCategories', [$cashbookId, $method]),
        disabled => count($chits) === 0,
        dataTest => 'cashbook-' . $method . '-excel-categories',
    }
    {include '../../templates/FileActionButton.latte',
        label => 'Stáhnout skeny ZIP',
        downloadUrl => $presenter->link(':Unit:CashbookExport:exportScans', [$cashbookId, $method]),
        disabled => ! $hasExportScans,
        dataTest => 'cashbook-' . $method . '-scans',
    }
</div>

{control prefix}
