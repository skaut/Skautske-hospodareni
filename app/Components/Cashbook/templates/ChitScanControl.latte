<!-- Button trigger modal -->
<button class="btn btn-sm btn-light d-inline" type="button" id="chitScanList" data-bs-toggle="modal" aria-haspopup="true" aria-expanded="false" data-bs-target="#chitScanModal-{$chitId}">
    <i class="fi fi-rr-folder-open" aria-hidden="true"></i>
    <span n:if="count($files) > 0" class="badge text-bg-light">{count($files)}</span>
</button>


<!-- Modal -->
<div class="modal fade" id="chitScanModal-{$chitId}" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Naskenované přílohy</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
            </div>
            <div class="modal-body">
                <div n:foreach="$files as $file" class="d-flex align-items-center gap-2 py-1" data-test="chit-scan-file">
                    {var $filePath = $file->getFilePath()}
                    <span class="me-auto text-truncate" title="{$filePath->getOriginalFilename()}">{$filePath->getOriginalFilename()|truncate:26}</span>
                    {include '../../templates/FileActionButton.latte',
                        label => 'Stáhnout soubor',
                        downloadUrl => $presenter->link(':Unit:CashbookExport:downloadScan', [$cashbookId, $chitId, $filePath->getPath()]),
                        openUrl => $filePath->isPdf() ? $presenter->link(':Unit:CashbookExport:downloadScan', [$cashbookId, $chitId, $filePath->getPath(), open => true]) : null,
                        variant => 'light',
                        compact => true,
                    }
                    <a n:href="remove! $filePath->getPath()"
                    n:if="$isEditable"
                            title="Smazat soubor"
                            aria-label="Smazat soubor"
                            data-bs-toggle="tooltip"
                            data-confirm="Opravdu chcete smazat sken?"
                            class="btn btn-sm btn-outline-danger"><i class="fi fi-rr-trash" aria-hidden="true"></i></a>
                </div>
                {control uploadForm}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Zavřít</button>
            </div>
        </div>
    </div>
</div>
