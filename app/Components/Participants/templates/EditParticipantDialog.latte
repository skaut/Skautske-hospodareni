{layout $layout}

{block dialog-title}Upravit účastníka{/block}

{block dialog-body}
    {if $isPersonalDataNotAccessible}
        <div class="alert alert-info mb-3" role="status" data-test="participant-personal-data-not-accessible">
            <div class="d-flex gap-2">
                <i class="fi fi-rr-info mt-1" aria-hidden="true"></i>
                <p class="mb-0">K osobním údajům tohoto účastníka nemáte ve skautISu oprávnění. Upravit můžete jen účast a platbu.</p>
            </div>
        </div>
    {elseif $personalDataSaveError !== null}
        <div class="alert alert-danger mb-3" role="alert" data-test="participant-personal-data-save-error">
            <div class="d-flex gap-2">
                <i class="fi fi-rr-triangle-warning mt-1" aria-hidden="true"></i>
                <div>
                    <strong>Osobní údaje se nepodařilo uložit.</strong>
                    <p class="mb-0 mt-1">{$personalDataSaveError}</p>
                    <p class="mb-0 mt-1">Účast a platbu můžete uložit i bez změny osobních údajů. Osobní údaje pak upravte přímo ve skautISu.</p>
                </div>
            </div>
        </div>
    {elseif $missingPersonalData !== null}
        <div class="alert alert-warning mb-3" role="alert" data-test="participant-personal-data-incomplete">
            <div class="d-flex gap-2">
                <i class="fi fi-rr-triangle-warning mt-1" aria-hidden="true"></i>
                <div>
                    <strong>Osobní údaje nejsou úplné: chybí {$missingPersonalData}.</strong>
                    <p class="mb-0 mt-1">Doplňte je a uložte. Pokud je neznáte, můžete uložit jen účast a platbu.</p>
                </div>
            </div>
        </div>
    {/if}
    {control form}
{/block}
