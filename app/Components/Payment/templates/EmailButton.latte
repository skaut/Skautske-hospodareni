<div class="btn-group" title="{if !$canSend}Pro rozeslání emailů musí být přiřazený email a bankovní účet v nastavená platební skupiny{/if}">
    <button n:class="!$canSend ? disabled, 'btn btn-light dropdown-toggle'" type="button" id="emailsDropd"
            data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
        <i class="fi fi-rr-envelope-open" aria-hidden="true"></i> E-mail <span class="caret"></span>
    </button>
    <div class="dropdown-menu" aria-labelledby="emailsDropdown">
        <a n:href="sendTest!" class="dropdown-item">
            <i class="fi fi-rr-pencil-ruler" aria-hidden="true"></i>
            Zaslat testovací e-mail
        </a>
        {if $isGroupSendActive}
            <a n:href="sendGroup!"
                    class="dropdown-item"
                    data-confirm="Opravdu chcete rozeslat e-maily?">
                <i class="fi fi-rr-paper-plane" aria-hidden="true"></i>
                Rozeslat e-maily
            </a>
        {else}
            {* Not a link: the action is unavailable, so the reason is shown instead of
               being hidden behind a click that only opens an alert. *}
            <span class="dropdown-item-text text-body-secondary">
                <i class="fi fi-rr-paper-plane" aria-hidden="true"></i> Rozeslat e-maily
                <small class="d-block">Nejsou žádné platby s vyplněným e-mailem k odeslání</small>
            </span>
        {/if}
        {if $isReminderSendActive}
        <a  n:href="sendGroupReminder!"
                class="dropdown-item"
                data-confirm="Opravdu chcete rozeslat upomínkové e-maily všem nespárovaným platbám?">
            <i class="fi fi-rr-bell" aria-hidden="true"></i>
                Rozeslat upomínky
        </a>
        {else}
            <span class="dropdown-item-text text-body-secondary">
                <i class="fi fi-rr-bell" aria-hidden="true"></i> Rozeslat upomínky
                <small class="d-block">Šablona e-mailu není nastavena</small>
            </span>
        {/if}
    </div>
</div>