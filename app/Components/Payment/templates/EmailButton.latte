{if $canSend}
<div class="btn-group">
    <button class="btn btn-light btn-sm dropdown-toggle" type="button" id="emailsDropdown"
            data-test="payment-group-email-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        <i class="fi fi-rr-envelope-open" aria-hidden="true"></i> E-mail <span class="caret"></span>
    </button>
    <div class="dropdown-menu" aria-labelledby="emailsDropdown" data-test="payment-group-email-menu">
        <a n:href="sendTest!" class="dropdown-item" data-test="payment-group-email-test">
            <i class="fi fi-rr-pencil-ruler" aria-hidden="true"></i>
            Zaslat testovací e-mail
        </a>
        {if $isGroupSendActive}
            <a n:href="sendGroup!"
                    class="dropdown-item ajax">
                <i class="fi fi-rr-paper-plane" aria-hidden="true"></i>
                Rozeslat e-maily
            </a>
        {else}
            {* Not a link: the action is unavailable, so the reason is shown instead of
               being hidden behind a click that only opens an alert. *}
            <span class="dropdown-item-text text-body-secondary">
                <i class="fi fi-rr-paper-plane" aria-hidden="true"></i> Rozeslat e-maily
                <small class="d-block">Nejsou žádné platby s vyplněným e-mailem k odeslání</small>
            </span>
        {/if}
        {if $isReminderSendActive}
        <a  n:href="sendGroupReminder!"
                class="dropdown-item"
                data-confirm="Opravdu chcete rozeslat upomínkové e-maily všem nespárovaným platbám?">
            <i class="fi fi-rr-bell" aria-hidden="true"></i>
                Rozeslat upomínky
        </a>
        {else}
            <span class="dropdown-item-text text-body-secondary">
                <i class="fi fi-rr-bell" aria-hidden="true"></i> Rozeslat upomínky
                <small class="d-block">Šablona e-mailu není nastavena</small>
            </span>
        {/if}
    </div>
</div>
{else}
    <span class="d-inline-block" tabindex="0" data-bs-toggle="tooltip" title="Pro rozeslání e-mailů musí být přiřazený e-mail odesílatele v nastavení platební skupiny.">
        <span class="btn btn-light btn-sm disabled" aria-disabled="true" data-test="payment-group-email-toggle">
            <i class="fi fi-rr-envelope-open" aria-hidden="true"></i> E-mail
        </span>
    </span>
{/if}
