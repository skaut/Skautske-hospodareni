{* Only the content of the snippet is replaced on refresh, so the polling attributes live inside it. *}
<div n:snippet="status" aria-live="polite">
    <div data-task-queue-status
         data-refresh-url="{$refreshUrl}"
         data-active="{$isActive ? '1' : '0'}"
         data-test="task-queue-status">
        <section n:if="$jobs !== []" class="card mb-4" data-test="task-queue-status-panel">
            <div class="card-body">
                <h2 class="h5 mb-3">
                    <i class="fi fi-rr-paper-plane" aria-hidden="true"></i>
                    Odesílání e-mailů na pozadí
                </h2>

                <div n:foreach="$jobs as $job" n:class="!$iterator->last ? 'mb-4'" data-test="task-queue-job-{$job->id}">
                    {var $percent = $job->getProgressPercent()}
                    <div class="d-flex flex-wrap justify-content-between gap-2">
                        <strong>{$job->label}</strong>
                        <span data-test="task-queue-job-progress">
                            odesláno {$job->done} z {$job->total}
                            {if $job->isFinished() && !$job->hasProblems()} · hotovo{/if}
                        </span>
                    </div>
                    <div class="progress my-2" role="progressbar" aria-label="Průběh: {$job->label}"
                         aria-valuenow="{$percent}" aria-valuemin="0" aria-valuemax="100">
                        {* A finished batch is full even when nothing went out, so a failure must not look like success. *}
                        <div n:class="progress-bar, $job->isFinished() && !$job->hasProblems() ? bg-success, $job->isFinished() && $job->failed > 0 ? bg-danger" style="width: {$percent}%"></div>
                    </div>
                    <div class="small text-body-secondary">
                        Zadáno {$job->createdAt|date:'j. n. Y H:i'}, {$job->createdByName ?? 'automaticky'}
                        {if !$job->isFinished()} · e-maily odcházejí po dávkách každou minutu{/if}
                    </div>

                    <div n:if="$job->stalled" class="alert alert-warning small mt-2 mb-0" data-test="task-queue-job-stalled">
                        Odesílání se zastavilo. Dejte prosím vědět správci aplikace.
                    </div>
                    <div n:if="$job->postponedUntil !== null" class="alert alert-info small mt-2 mb-0" data-test="task-queue-job-postponed">
                        {if $job->postponedReason !== null}{$job->postponedReason} {/if}Odesílání je odložené do {$job->postponedUntil|date:'j. n. H:i'}, pak ho fronta zkusí znovu sama.
                    </div>

                    {* A whole batch usually fails for one reason, e.g. a sender Google refuses, so each reason shows once. *}
                    {var $failedByReason = $job->getProblemsByReason(\App\Model\TaskQueue\TaskItemState::FAILED)}
                    <div n:if="$failedByReason !== []" class="alert alert-danger small mt-2 mb-0" data-test="task-queue-job-failed">
                        {* The alert lays its children out in a row, so the reasons are stacked in one block. *}
                        <div>
                            <div n:foreach="$failedByReason as $reason => $labels" n:class="!$iterator->last ? 'mb-2'">
                                {var $count = count($labels)}
                                <p class="mb-1">
                                    <strong>Nepodařilo se odeslat {$count} {if $count === 1}e-mail{elseif $count < 5}e-maily{else}e-mailů{/if}.</strong>
                                    {$reason}
                                </p>
                                <ul class="mb-0">
                                    <li n:foreach="$labels as $label">{$label}</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    {var $uncertain = $job->getProblems(\App\Model\TaskQueue\TaskItemState::UNCERTAIN)}
                    <div n:if="$uncertain !== []" class="alert alert-warning small mt-2 mb-0" data-test="task-queue-job-uncertain">
                        U těchto e-mailů nevíme, jestli odešly, protože se zpracování přerušilo:
                        <ul class="mb-1">
                            <li n:foreach="$uncertain as $problem">{$problem->label}</li>
                        </ul>
                        Než je pošlete znovu, zkontrolujte odeslanou poštu e-mailu odesílatele skupiny.
                    </div>

                    {var $skipped = $job->getProblems(\App\Model\TaskQueue\TaskItemState::SKIPPED)}
                    <div n:if="$skipped !== []" class="small text-body-secondary mt-2" data-test="task-queue-job-skipped">
                        Vynecháno:
                        <ul class="mb-0">
                            <li n:foreach="$skipped as $problem">{$problem->label} – {$problem->message}</li>
                        </ul>
                    </div>

                    <div n:if="!$job->isFinished() && $canManage" class="d-flex flex-wrap gap-2 mt-2">
                        <a n:href="cancel! jobId => $job->id" class="btn btn-sm btn-outline-danger ajax"
                           data-confirm="Zrušit e-maily, které ještě čekají na odeslání? Ty, které už odešly, zůstanou."
                           data-test="task-queue-job-cancel">Zrušit čekající e-maily</a>
                    </div>

                    <div n:if="$job->isFinished()" class="d-flex flex-wrap gap-2 mt-2">
                        <a n:if="$finishedActionUrl !== null" href="{$finishedActionUrl}" class="btn btn-sm btn-light ajax"
                           data-test="task-queue-finished-action">{$finishedActionLabel}</a>
                        <a n:if="$job->hasProblems() && $canManage" n:href="acknowledge! jobId => $job->id"
                           class="btn btn-sm btn-light ajax" data-test="task-queue-job-acknowledge">Skrýt přehled</a>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
