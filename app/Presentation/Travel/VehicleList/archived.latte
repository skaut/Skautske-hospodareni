{block title}Archiv vozidel{/block}

{block content}
<div data-test="travel-vehicles-archive-page">
    <div class="card page-heading">
        <div class="card-body">
            <h1 class="h3 mb-2">Archiv vozidel</h1>
            <div class="page-lead">
                <i class="fi fi-rr-info" aria-hidden="true"></i>
                <span>Vozidla vyřazená z provozu jednotky {$unit->getDisplayName()}. Kterékoli z nich lze vrátit mezi aktivní.</span>
            </div>
        </div>
    </div>

    <section class="card" data-test="travel-vehicles-archive-table">
        <div class="card-body">
            {control grid}
        </div>
    </section>
</div>
{/block}
