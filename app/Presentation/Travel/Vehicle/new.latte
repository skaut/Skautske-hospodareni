{block content}
<div data-test="travel-vehicle-form-page">
    <div class="card page-heading">
        <div class="card-body">
            <h1 class="h3 mb-2" n:inner-block="title">Nové vozidlo</h1>
            {include pageLead, default: 'Zadejte údaje o novém vozidle pro cestovní příkazy.'}
        </div>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-8">
            <div class="card">
                <div class="card-body">
                    <strong>Údaje vozidla</strong>
                    <div class="mt-3">
                        <form n:name="formCreateVehicle" class="inline-errors">
                            <div class="mb-3">
                                {label type /}
                                {input type}
                            </div>
                            <div class="mb-3">
                                {label fuelType /}
                                {input fuelType}
                            </div>
                            <div class="mb-3">
                                {label registration /}
                                {input registration}
                            </div>
                            <div class="mb-3">
                                {label consumption /}
                                <div class="input-group mb-2">
                                    {input consumption}
                                    <span class="input-group-text" id="consumption-unit" data-test="travel-vehicle-consumption-unit">{$consumptionUnit}</span>
                                </div>
                            </div>
                            <div class="mb-3">
                                {label subunitId /}
                                {input subunitId}
                            </div>
                            <div class="mb-3">
                                {input send class => [btn, btn-primary]}
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
