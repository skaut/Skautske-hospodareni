{var $count = count($files)}

{if ! $isEditable && $files === []}
    <span class="btn btn-light disabled" title="Nemáte oprávnění upravovat vozidlo" data-bs-toggle="tooltip">
        Technický průkaz: žádné soubory
    </span>
{else}
    <div class="btn-group d-inline-block">
        <span n:snippet="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-popper-config='{ "strategy": "fixed" }' aria-haspopup="true" aria-expanded="false" data-test="roadworthy-menu-toggle">
            {var $count = count($files)}
            {if $count === 0}
                <button type="button" class="btn btn-primary dropdown-toggle">
                    <i class="fi fi-rr-cloud-upload-alt" aria-hidden="true"></i>
                    Nahrát technický průkaz
                </button>
            {else}
                <button type="button" class="btn btn-light dropdown-toggle">
                    Technický průkaz: {$count} soubor{if $count >= 5}ů{elseif $count > 1}y{/if}
                </button>
            {/if}
        </span>
        <div class="dropdown-menu dropdown-menu-start roadworthy-menu" n:snippet="">
            {foreach $files as $file}
            <div class="d-flex align-items-center gap-2 px-4 py-1" data-test="roadworthy-file">
                <span class="me-auto text-truncate" title="{$file->getOriginalFilename()}">{$file->getOriginalFilename()|truncate:26}</span>
                {include '../../../../../Components/templates/FileActionButton.latte',
                    label => 'Stáhnout soubor',
                    downloadUrl => $presenter->link(':Travel:Vehicle:downloadScan', [$vehicleId, $file->getPath()]),
                    openUrl => $file->isPdf() ? $presenter->link(':Travel:Vehicle:downloadScan', [$vehicleId, $file->getPath(), open => true]) : null,
                    variant => 'light',
                    compact => true,
                    dataTest => 'roadworthy-file-' . ($file->getOriginalFilename()|webalize),
                }
                <a n:href="remove! $file->getPath()"
                        n:if="$isEditable"
                        title="Smazat soubor"
                        aria-label="Smazat soubor"
                        data-bs-toggle="tooltip"
                        class="btn btn-sm btn-outline-danger ajax"><i class="fi fi-rr-trash" aria-hidden="true"></i></a>
            </div>
            <div class="dropdown-divider"></div>
            {/foreach}
            <form n:name="uploadForm" class="px-4 py-1 text-center ajax inline-errors" n:if="$isEditable">
                <input n:name="scan" class="d-none" id="scan-upload-control">
                <label for="scan-upload-control" class="btn btn-light">
                    <i class="fi fi-rr-cloud-upload-alt" aria-hidden="true"></i>
                    {if $files === []}Vybrat soubor{else}Nahrát další soubor{/if}
                </label>
                <div class="text-danger" n:foreach="$form->errors as $error">{$error}</div>
            </form>
        </div>
    </div>
{/if}
