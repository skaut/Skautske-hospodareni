{block title}Upravit oznámení{/block}

{block content}
<div data-test="admin-announcements-form-page">
    <div class="card page-heading">
        <div class="card-body">
            <h1 class="h3 mb-2">Upravit oznámení</h1>
            {include pageLead, default: 'Upravte zprávu pro uživatele. Změny se po uložení projeví na nástěnce.', class: 'mb-3'}
            <div class="page-heading-actions d-flex flex-wrap gap-2">
                <a n:href="default" class="btn btn-sm btn-outline-secondary">
                    <i class="fi fi-rr-arrow-left" aria-hidden="true"></i>
                    Zpět na oznámení
                </a>
            </div>
        </div>
    </div>

    {include '@form.latte'}
</div>
{/block}
