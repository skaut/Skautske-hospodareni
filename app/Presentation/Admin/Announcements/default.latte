{block title}Správa oznámení{/block}

{block content}
<div data-test="admin-announcements-page">
    <div class="card page-heading">
        <div class="card-body">
            <h1 class="h3 mb-2">Oznámení</h1>
            {include pageLead, default: 'Spravujte zprávy zobrazované uživatelům na nástěnce. Nová oznámení se zveřejní ihned.'}
        </div>
    </div>

    <section class="card" data-test="admin-announcements-list-card">
        <div class="card-body" data-test="admin-announcements-list">
            {control grid}
        </div>
    </section>
</div>
{/block}
