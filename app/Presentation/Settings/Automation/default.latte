

{block title}Automatizace{/block}

{block content}
<div data-test="settings-automation-page">
    <div class="card page-heading">
        <div class="card-body">
            <h1 class="h3 mb-2">Automatizace</h1>
            <div class="page-lead">
                <i class="fi fi-rr-info" aria-hidden="true"></i>
                <span>Přehled pravidelných úloh, které systém spouští automaticky na pozadí.</span>
            </div>
        </div>
    </div>

    <article class="card" data-test="settings-automation-card-cron">
        <div class="card-body">
            <strong>Pravidelné úlohy</strong>
        </div>
        <div class="list-group list-group-flush">
            <div n:foreach="$jobs as $job" class="list-group-item">
                <div class="d-flex align-items-start gap-3">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary-subtle text-primary tile-icon-sm">
                        <i class="fi fi-rr-time-check" aria-hidden="true"></i>
                    </span>
                    <div class="flex-grow-1">
                        <strong>{$job->title}</strong>
                        {if $job->paused}
                            <span class="badge text-bg-warning ms-2" data-test="settings-automation-paused-{$job->name}">Pozastaveno</span>
                        {else}
                            <span class="badge text-bg-light ms-2" data-test="settings-automation-interval-{$job->name}">{$job->getIntervalLabel()}</span>
                        {/if}
                        <p class="text-body-secondary small mb-0 mt-1">{$job->description}</p>
                        <p class="text-body-secondary small mb-0">
                            {if $job->lastFinishedAt !== null}
                                Naposledy proběhlo {$job->lastFinishedAt|date:'j. n. Y H:i'}.
                            {else}
                                Zatím neproběhlo.
                            {/if}
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </article>
</div>
{/block}
