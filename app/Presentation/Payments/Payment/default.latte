{block content}
<div data-test="payment-group-detail-page">
    <div class="card page-heading">
        <div class="card-body">
            <h1 n:inner-block="title" class="h3 mb-2">{$group->name}</h1>
            {include pageLead, default: 'Přehled plateb ve skupině, jejich stavu, párování, rozesílání údajů a dostupných hromadných akcí.'}
            <div class="d-flex flex-wrap gap-2 align-items-center text-body-secondary small mb-3">
                {$group->state|groupState|noescape}
                <span>·</span>
                {control unit}
                <span>·</span>
                {if $group->type === NULL}Obecná
                {elseif $group->type === "camp"}Tábor
                {elseif $group->type === "event"}Akce
                {elseif $group->type === "registration"}Registrace{/if}
            </div>
            <div class="page-heading-actions d-flex flex-wrap gap-2 align-items-center" n:if="$isEditable">
                {if $group->state === 'open'}
                    <a n:href="closeGroup!" class="btn btn-light btn-sm" data-test="payment-group-close">
                        <i class="fi fi-rr-lock" aria-hidden="true"></i> Uzavřít
                    </a>
                    <a n:href=":Payments:Group:edit $group->id" data-test="payment-group-edit-link" class="btn btn-light btn-sm">
                        <i class="fi fi-rr-edit" aria-hidden="true"></i> Upravit skupinu
                    </a>
                {else}
                    <a n:href="openGroup!" class="btn btn-outline-warning btn-sm" data-test="payment-group-open">
                        <i class="fi fi-rr-unlock" aria-hidden="true"></i> Znovu otevřít
                    </a>
                    <a n:href="openRemoveDialog!" class="ajax btn btn-outline-danger btn-sm">
                        <i class="fi fi-rr-trash" aria-hidden="true"></i> Smazat skupinu
                    </a>
                {/if}
                <span n:snippet="bankAccountTransactionsToggle">
                    {if $hasBankAccount}
                        {if $bankAccountTransactionsLoaded}
                            <a n:href="hideBankAccountTransactions!" class="ajax btn btn-light btn-sm" data-test="payment-group-bank-account-toggle">
                                <i class="fi fi-rr-eye-crossed" aria-hidden="true"></i> Skrýt bankovní platby
                            </a>
                        {else}
                            <a n:href="loadBankAccountTransactions!" class="ajax btn btn-light btn-sm" data-test="payment-group-bank-account-toggle">
                                <i class="fi fi-rr-bank" aria-hidden="true"></i> Zobrazit bankovní platby
                            </a>
                        {/if}
                    {else}
                        <span class="d-inline-block" tabindex="0" data-bs-toggle="tooltip" title="Není připojený žádný bankovní účet.">
                            <span class="btn btn-light btn-sm disabled" aria-disabled="true" data-test="payment-group-bank-account-toggle-disabled">
                                <i class="fi fi-rr-bank" aria-hidden="true"></i> Zobrazit bankovní platby
                            </span>
                        </span>
                    {/if}
                </span>
            </div>
        </div>
    </div>

    <div n:snippet="bankAccountTransactions">
        <section n:if="$bankAccountTransactionsLoaded" class="card mb-4" data-test="payment-group-bank-account-transactions">
            <div class="card-body">
                <h2 class="h4 mb-3">
                    <i class="fi fi-rr-bank me-2" aria-hidden="true"></i>Přehled plateb pro tuto skupinu
                </h2>
                {if $hasBankAccount}
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                        <div>
                            {if $bankAccount !== null}
                                <p class="text-body-secondary mb-0">
                                    Příchozí transakce z účtu <strong>{$bankAccount->getName()}</strong> ({$bankAccount->getNumber()}).
                                </p>
                            {/if}
                            <p n:if="$bankAccountDetail?->focusTargetLabel !== null" class="small text-body-secondary mb-0">
                                {$bankAccountDetail->focusTargetLabel}
                            </p>
                        </div>
                        <a n:href="loadBankAccountTransactions! paymentId => $bankAccountPaymentId" class="ajax btn btn-light" data-test="payment-group-bank-account-reload">
                            <i class="fi fi-rr-refresh me-1" aria-hidden="true"></i>
                            Obnovit přehled
                        </a>
                    </div>

                    {if $bankAccountDetail === null || $bankAccountDetail->transactionRows === null}
                        <div class="alert alert-danger mb-0" n:if="$bankAccountDetail?->errorMessage !== null">{$bankAccountDetail->errorMessage}</div>
                        <div class="alert alert-warning mb-0" n:if="$bankAccountDetail?->warningMessage !== null">{$bankAccountDetail->warningMessage}</div>
                    {elseif count($bankAccountDetail->transactionRows) > 0}
                        {control bankAccountTransactionsGrid}
                    {else}
                        <p class="alert alert-info text-center mb-0">Nebyly nalezeny žádné příchozí transakce.</p>
                    {/if}
                {else}
                    <p class="alert alert-info mb-0">Platební skupina nemá připojený bankovní účet.</p>
                {/if}
            </div>
        </section>
    </div>

    <section class="card mb-4" data-test="payment-group-progress">
        <div class="card-body">
            {control progress}
        </div>
    </section>

    <div class="alert alert-warning text-center" n:if="$notSentPaymentsCount !== 0">
        <i class="fi fi-rr-triangle-warning" aria-hidden="true"></i>
        {$notSentPaymentsCount}
        {if notSentPaymentsCount === 1}nezaplacená platba nemá odeslány
        {elseif $notSentPaymentsCount < 4}nezaplacené platby nemají odeslány
        {else}nezaplacených plateb nemá odesláno{/if}
        platební údaje
    </div>

    <section class="card mb-4" n:inner-if="$isEditable && $group->state === 'open'" data-test="payment-group-actions">
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    {if $group->type === 'registration'}
                        <a n:href=":Payments:Journal: groupId => $group->id" class="btn btn-light btn-sm" data-test="payment-group-journal-link">
                            <i class="fi fi-rr-book-open-reader" aria-hidden="true"></i>
                            Časopisy
                        </a>
                    {/if}

                    {control emailButton:light}
                    {control pairButton:light}
                    <a n:href=":Payments:Repayment: $group->id" class="btn btn-light btn-sm" data-test="payment-group-repayments-link">
                        <i class="fi fi-rr-arrow-left" aria-hidden="true"></i>
                        Vratky
                    </a>
                    {var $attrs = $nextVS === null
                                ? [
                                    'data-bs-toggle' => 'tooltip',
                                    'title' => 'Pro dogenerování VS je třeba nejdříve vyplnit VS k alespoň k jedné platbě (1-10 číslic).<br>'
                                                . ' Další budou podle něj dogenerovány jako +1.'
                                ]
                                : []
                    }
                    <span n:attr="$attrs">
                        <a n:href="generateVS!" n:class="$nextVS === null ? disabled, btn, btn-light, btn-sm">Dogenerovat VS</a>
                    </span>
                    <a n:href="export! $group->id" class="btn btn-light btn-sm">Exportovat</a>
                </div>
                <div class="dropdown d-inline-block">
                    <button class="btn btn-primary dropdown-toggle" type="button" id="addPayments"
                            data-test="payment-add-button-toggle"
                            data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <i class="fi fi-rr-plus-small" aria-hidden="true"></i> Přidat platbu
                    </button>
                    <div class="dropdown-menu" aria-labelledby="addPayments" data-test="payment-add-button-menu">
                        <a n:if="$group->type === 'camp'"
                                n:href=":Payments:Participants: $group->id" class="dropdown-item" data-test="payment-add-button-item-participant">… za účastníka</a>

                        <a n:if="$group->type === 'event'"
                                n:href=":Payments:Participants: $group->id" class="dropdown-item" data-test="payment-add-button-item-participant">… za účastníka</a>

                        <a n:if="$group->type === 'registration'"
                                n:href=":Payments:People: $group->id" class="dropdown-item" data-test="payment-add-button-item-registration">… za registraci</a>

                        <a n:if="$group->type === 'education'"
                                n:href=":Payments:Participants: $group->id" class="dropdown-item" data-test="payment-add-button-item-participant">… za účastníka</a>

                        <a n:if="$group->type !== 'education'"
                                n:href=":Payments:People: $group->id" class="dropdown-item" data-test="payment-add-button-item-member">… za člena</a>

                        <a n:href="paymentDialog:open!" class="dropdown-item ajax" data-test="payment-add-button-item-general">… obecnou</a>
                        <a n:href="importDialog:open!" class="dropdown-item ajax" data-test="payment-add-button-item-import">… import</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {if $isEditable}
        {control removeGroupDialog}
        {if $group->state === 'open'}
            {control paymentDialog}
            {control importDialog}
            {control splitPaymentDialog}
        {/if}

        {control paymentNoteDialog}

    {/if}

    <section class="card" data-test="payment-group-grid">
        <div class="card-body">
            {snippet grid}
                {control paymentList}
            {/snippet}
        </div>
    </section>
</div>
{/block}
