{block content}
<div data-test="invoice-sequence-edit-page">
    <div class="card page-heading">
        <div class="card-body">
            <h1 n:inner-block="title" class="h3 mb-2">Úprava fakturační řady {$invoiceSequence->getDisplayLabel()}</h1>
            {include pageLead, default: 'Správa číselné řady, bankovního párování a e-mailových šablon pro vybranou fakturační řadu.', class: 'mb-3'}
            <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <a n:href=":Payments:InvoiceList:default, invoiceSequenceId => $invoiceSequence->getId(), unitId => $unitId" class="btn btn-outline-secondary btn-sm" data-test="invoice-sequence-edit-open">
                        <i class="fi fi-rr-file-invoice" aria-hidden="true"></i>
                        Otevřít faktury v řadě
                    </a>
                    <a n:href=":Payments:InvoiceSequenceList:default, unitId => $unitId" class="btn btn-outline-secondary btn-sm" data-test="invoice-sequence-edit-back">
                        <i class="fi fi-rr-arrow-left" aria-hidden="true"></i>
                        Zpět na správu řad
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="card" data-help-form>
        <div class="card-body">
            <div id="bankAccountUnavailableAlert" class="alert alert-secondary small d-none">
                <strong>Bankovní párování je zatím nedostupné.</strong>
                Nejprve vyberte bankovní účet a uložte fakturační řadu.
            </div>
            <div id="emailUnavailableAlert" class="alert alert-secondary small d-none">
                <strong>E-mailové šablony jsou zatím nedostupné.</strong>
                Nejprve vyberte e-mail odesílatele a uložte fakturační řadu.
            </div>
            {control editForm}
        </div>
    </div>
</div>
