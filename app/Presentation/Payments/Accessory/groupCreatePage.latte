<div data-test="{$pageTest}">
    <div class="card page-heading">
        <div class="card-body">
            {* $subject is a SkautIS-provided name, so it must go through Latte escaping. *}
            <h1 n:inner-block="title" class="h3 mb-2">{$heading}<span
                    n:ifset="$subject" class="text-body-secondary fw-normal"> {$subject}</span></h1>
            <div class="page-lead mb-3">
                <i class="fi fi-rr-info" aria-hidden="true"></i>
                <span>{$description}</span>
            </div>
            <div class="page-heading-actions d-flex flex-wrap gap-2 align-items-center">
                <a href="{$backLink}" class="btn btn-outline-secondary btn-sm">
                    <i class="fi fi-rr-arrow-left" aria-hidden="true"></i>
                    {$backLabel}
                </a>
            </div>
        </div>
    </div>

    <div class="card" data-help-form>
        <div class="card-body">
            {control $formControl}
        </div>
    </div>
</div>
