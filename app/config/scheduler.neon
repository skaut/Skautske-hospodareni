messenger:
    buses:
        commandBus:
            singleHandlerPerMessage: true
            middleware:
                - App\Model\Infrastructure\Services\Messenger\LoggingMiddleware(level: 'debug')
        eventBus:
            allowNoHandlers: true
        queryBus:
            singleHandlerPerMessage: true

# Hosting neumí cron, úlohy spouští www/cron.php volaný z externího serveru (.docs/cron.md).
scheduler:
    jobs:
        paymentPairing: { cron: '0 */2 * * *', callback: [ @App\Model\Bank\BankService, pairAutomaticGroups ] }
        paymentReminders: { cron: '0 6 * * *', callback: [ @App\Model\Payment\Mailing\AutomaticPaymentReminders, queueDue ] }
        # Last: the queue uses only the time the jobs before it left in the 30 s of the request.
        taskQueue: { cron: '* * * * *', callback: [ @App\Model\TaskQueue\TaskQueueProcessor, processDue ] }

services:
    - App\Model\Cron\CronRunner(lockDir: %tempDir%/scheduler)
