messenger:
    buses:
        commandBus:
            singleHandlerPerMessage: true
            middleware:
                - App\Model\Infrastructure\Services\Messenger\LoggingMiddleware(level: 'debug')
        eventBus:
            allowNoHandlers: true
        queryBus:
            singleHandlerPerMessage: true

# Hosting neumí cron, úlohy spouští www/cron.php volaný z externího serveru (.docs/cron.md).
scheduler:
    jobs:
        paymentPairing: { cron: '0 */2 * * *', callback: [ @App\Model\Bank\BankService, pairAutomaticGroups ] }

services:
    - App\Model\Infrastructure\Scheduler\CronRunner(lockDir: %tempDir%/scheduler)
