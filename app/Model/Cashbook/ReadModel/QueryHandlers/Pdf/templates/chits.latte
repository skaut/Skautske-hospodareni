{*
$income - seznam příjmových dokladů
$outcome - seznam výdajových dokladů
$officialName - oficiální název organizační jednotky
$pokladnik - (pro HPD)
$list - seznam příjemců (pro HPD)
$totalPayment - celková částka (pro HPD)
*}
<style>
table {
    border-spacing: 0;
    width: 770px;
    overflow:wrap;
}

.paragonTable td {
    height: 27px;
}

.itemsTable {
    font-size:0.9em;
    color:#777;
    border-color:#777;
    margin-top:20px;
}

.formula {
    font-size:0.9em;
    color:#777;
    padding-top:10px;
}

.income-chit {
    break-inside: avoid;
}

.income-chit + .income-chit {
    margin-top: 20px;
}

.chit-page {
    break-before: page;
    break-after: page;
}

</style>
{* Příjmové doklady jdou za sebou, kolik se jich vejde na stránku, a žádný se nerozdělí mezi dvě stránky.
   Hromadný příjmový a každý výdajový doklad mají vlastní stránku. *}
{foreach $income as $chit}
    {if $chit->isHpd()}
        <div class="chit-page">
            {include chits.hpd.latte "chit"=>$chit, "list"=>$list, "pokladnik"=>$pokladnik, "totalPayment"=>$totalPayment}
        </div>
    {else}
        <div class="income-chit">
            {include chits.in.latte "chit"=>$chit}
        </div>
    {/if}
{/foreach}

{foreach $outcome as $chit}
    <div class="chit-page">
        {include chits.out.latte "chit"=>$chit}
    </div>
{/foreach}
